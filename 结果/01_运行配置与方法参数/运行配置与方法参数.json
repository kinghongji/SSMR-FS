{
  "random_seed": 42,
  "main_sample_size": 300,
  "sample_size_validation": [
    200,
    500,
    800,
    1000,
    1300,
    1500
  ],
  "repeated_times": 30,
  "figure_dpi": 600,
  "temperature": {
    "temp_min": -18,
    "temp_max": 18,
    "min_days": 1,
    "max_days": 10
  },
  "baseline": {
    "input_dim": 11,
    "sobol_scramble": true,
    "maxpro_exchange_factor": 4
  },
  "source_pool": {
    "scenario_count_per_type": 180,
    "stratified_count_per_stratum": 10,
    "risk_pool_size": 1800,
    "time_layers": [
      [
        "1-3 d",
        1,
        3
      ],
      [
        "4-6 d",
        4,
        6
      ],
      [
        "7-10 d",
        7,
        10
      ]
    ],
    "temperature_layers": [
      [
        "freezing",
        -18,
        -1
      ],
      [
        "chilled",
        0,
        4
      ],
      [
        "transition",
        5,
        8
      ],
      [
        "risk",
        9,
        14
      ],
      [
        "abuse",
        15,
        18
      ]
    ],
    "path_type_layers": [
      "stable",
      "warming",
      "cooling",
      "oscillating"
    ],
    "amplitude_layers": [
      [
        "low",
        1
      ],
      [
        "medium",
        3
      ],
      [
        "high",
        6
      ]
    ],
    "risk_scenarios": [
      "cold_boundary",
      "transition_4_8",
      "above_8_risk",
      "above_15_abuse",
      "freeze_thaw"
    ]
  },
  "selection": {
    "objective": "candidate_constrained_sequential_energy_distance",
    "distance_block_size": 256
  },
  "storage_temperature_records": {
    "file_path": "210条实验室冰箱储藏温度记录.xlsx",
    "sheet_name": "实际每日温度---菌落",
    "id_column": "样本名称",
    "day_columns": [
      "第1天实际温度",
      "第2天实际温度",
      "第3天实际温度",
      "第4天实际温度",
      "第5天实际温度",
      "第6天实际温度",
      "第7天实际温度",
      "第8天实际温度",
      "第9天实际温度",
      "第10天实际温度"
    ]
  },
  "features": {
    "pca_explained_variance": 0.95,
    "logdet_regularization": 1e-06
  },
  "result_root": "../结果",
  "excel_main_name": "N300_五种方法主比较.xlsx",
  "excel_repeat_name": "N300_五种方法30次重复.xlsx",
  "excel_sample_size_name": "五种方法不同输出数量验证.xlsx"
}